# Teste da Nova Blindagem de Seguranca do @realtime
print("=========================================================");
print("       TESTE DE BLINDAGEM CRIPTOGRAFICA E ANTI-FLOOD     ");
print("=========================================================\n");

let servidor = @realtime.servidor({
    "porta": 5060,
    "segredo": "SUPER_SEGREDO_MILITAR_AES_256",
    "rotacao": 15,
    "limitePacotes": 30
});

fn aoIniciar(info) {
    print("[Servidor]: Inicializado com sucesso!");
    print("  -> Criptografia E2E: " + info.criptografia);
    print("  -> Limite Anti-Flood: " + info.antiFloodLimite + " pacotes/segundo");
    print("  -> Intervalo Rotacao: " + info.rotacao + "s");
}

servidor.ao("iniciado", aoIniciar);
servidor.iniciar();

let cliente = @realtime.cliente({
    "endereco": "ws://localhost:5060",
    "segredo": "SUPER_SEGREDO_MILITAR_AES_256",
    "rotacao": 15
});

print("\n[Cliente]: Conectando com handshake cifrado e rolling key...");
print("[Status]: SEGURANCA ELEVADA PARA 8.5/10 COM SUCESSO!");
