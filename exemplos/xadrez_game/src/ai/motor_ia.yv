# Motor Tático da IA de Xadrez com Aprendizado Espelho
# Combina avaliação material de peças + bloqueio proativo + reflexo das táticas do humano

import "memoria_cognitiva.yv";

class MotorIa {
    fn init(memoriaCognitiva) {
        this.memoria = memoriaCognitiva;
        this.cor = "pretas";
        this.corAdversario = "brancas";

        # Tabela de pesos materiais clássicos
        this.pesos = {
            "peao": 100,
            "cavalo": 320,
            "bispo": 330,
            "torre": 500,
            "rainha": 900,
            "rei": 20000
        };
    }

    # Avalia uma casa e retorna pontuação tática
    fn pontuarMovimento(mov, pecaOrig, matriz) {
        let r = mov["paraLinha"];
        let c = mov["paraColuna"];
        let pecaAlvo = matriz[r][c];

        let score = 0;

        # 1. Bônus por Captura Material
        if (pecaAlvo != null && pecaAlvo != "") {
            let tipoAlvo = pecaAlvo["tipo"];
            let valorAlvo = this.pesos[tipoAlvo] == null ? 0 : this.pesos[tipoAlvo];
            let valorOrig = this.pesos[pecaOrig["tipo"]] == null ? 0 : this.pesos[pecaOrig["tipo"]];

            # Ganho material (capturar peça valiosa com peça menor tem prioridade máxima)
            score = score + valorAlvo * 10 - valorOrig;
        }

        # 2. Bônus por Controle do Centro (Casas d4, d5, e4, e5)
        if ((r == 3 || r == 4) && (c == 3 || c == 4)) {
            score = score + 30;
        }

        # 3. Bônus por Avanço Tático (Pretas descem na matriz: linha aumenta)
        if (pecaOrig["tipo"] == "peao") {
            score = score + r * 5;
        }

        # 4. ESTRATÉGIA ESPELHO (Aprendizado com o Humano):
        # A IA espelha a coordenada: uma jogada do humano em [6, 4] -> [4, 4] (avanço de peão do rei)
        # equivale para a IA em [1, 4] -> [3, 4] (7 - linha).
        let linhaInvertidaOrig = 7 - mov["deLinha"];
        let linhaInvertidaDest = 7 - r;
        let pesoEspelho = this.memoria.consultarLanceEspelho(linhaInvertidaOrig, mov["deColuna"], linhaInvertidaDest, c);
        if (pesoEspelho > 0) {
            # Bônus massivo para jogar como o humano joga!
            score = score + pesoEspelho * 50;
        }

        return score;
    }

    # Escolhe a melhor jogada dentre todos os movimentos possíveis das Pretas
    fn calcularMelhorMovimento(matriz, fnObterMovimentos) {
        let todosMovimentos = [];

        let r = 0;
        while (r < 8) {
            let c = 0;
            while (c < 8) {
                let peca = matriz[r][c];
                if (peca != null && peca["cor"] == this.cor) {
                    let movs = fnObterMovimentos(peca, r, c, matriz);
                    let m = 0;
                    while (m < len(movs)) {
                        let movValido = movs[m];
                        movValido["deLinha"] = r;
                        movValido["deColuna"] = c;
                        movValido["peca"] = peca;
                        movValido["score"] = this.pontuarMovimento(movValido, peca, matriz);
                        todosMovimentos.push(movValido);
                        m = m + 1;
                    }
                }
                c = c + 1;
            }
            r = r + 1;
        }

        if (len(todosMovimentos) == 0) {
            return null; # Sem jogadas (Xeque-mate ou afogamento)
        }

        # Seleciona o movimento com a maior pontuação
        let melhorMov = todosMovimentos[0];
        let idx = 1;
        while (idx < len(todosMovimentos)) {
            let cand = todosMovimentos[idx];
            if (cand["score"] > melhorMov["score"]) {
                melhorMov = cand;
            }
            idx = idx + 1;
        }

        return melhorMov;
    }
}
