# 4. Helper de Extração de User ID do Header Authorization / Query
fn extrair_user_id(req) {
    if (req.has("headers")) {
        let headers = req["headers"];
        if (headers.has("X-User-Id")) {
            return to_int(headers["X-User-Id"]);
        }
        if (headers.has("x-user-id")) {
            return to_int(headers["x-user-id"]);
        }
    }
    if (req.has("query")) {
        let q = req["query"];
        if (q.has("user_id")) {
            return to_int(q["user_id"]);
        }
    }
    return 2; # Default para o Santhyago
}

# 5. Roteamento de Requisições HTTP REST
fn api_router(req) {
    let path = req["path"];
    let method = req["method"];
    let body = req["body"];
    let user_id = extrair_user_id(req);

    # Endpoint de Health Check
    if (path == "/api/health") {
        return {
            "status": 200,
            "body": { "ok": true, "engine": "Yvira Native HTTP/SQLite Core", "timestamp": "2026-11-02" }
        };
    }

    # Endpoint de Autenticação (Login)
    if (path == "/api/auth/login" && method == "POST") {
        let user = body["username"];
        let pass = body["senha"];
        let rows = @query("SELECT id, username, nome FROM usuarios WHERE username = ? AND senha = ?;", [user, pass]);
        if (rows.length() > 0) {
            let u = rows[0];
            return {
                "status": 200,
                "body": {
                    "sucesso": true,
                    "usuario": u,
                    "token": "yv_token_" + u["id"] + "_" + user
                }
            };
        } else {
            return {
                "status": 401,
                "body": { "sucesso": false, "mensagem": "Usuário ou senha inválidos." }
            };
        }
    }

    # Endpoint de Dashboard Resumo Consolidado
    if (path == "/api/dashboard" && method == "GET") {
        let receitas_res = @query("SELECT SUM(valor) as total FROM lancamentos WHERE user_id = ? AND tipo = 'RECEITA' AND status = 'CONFIRMADO';", [user_id]);
        let despesas_res = @query("SELECT SUM(valor) as total FROM lancamentos WHERE user_id = ? AND tipo = 'DESPESA' AND status = 'CONFIRMADO';", [user_id]);
        let dividas_res = @query("SELECT SUM(valor) as total FROM lancamentos WHERE user_id = ? AND tipo = 'DIVIDA';", [user_id]);
        let contas_res = @query("SELECT SUM(saldo_atual) as total FROM contas_bancarias WHERE user_id = ?;", [user_id]);
        let cartoes_res = @query("SELECT SUM(limite) as total_limite FROM cartoes_credito WHERE user_id = ?;", [user_id]);

        let total_receitas = receitas_res.length() > 0 && receitas_res[0]["total"] != null ? receitas_res[0]["total"] : 0.0;
        let total_despesas = despesas_res.length() > 0 && despesas_res[0]["total"] != null ? despesas_res[0]["total"] : 0.0;
        let total_dividas = dividas_res.length() > 0 && dividas_res[0]["total"] != null ? dividas_res[0]["total"] : 0.0;
        let saldo_contas = contas_res.length() > 0 && contas_res[0]["total"] != null ? contas_res[0]["total"] : 0.0;
        let limite_cartoes = cartoes_res.length() > 0 && cartoes_res[0]["total_limite"] != null ? cartoes_res[0]["total_limite"] : 0.0;

        let ultimos = @query("SELECT l.*, c.nome as categoria_nome, c.cor as categoria_cor, b.banco as conta_nome 
                              FROM lancamentos l 
                              LEFT JOIN categorias c ON l.categoria_id = c.id 
                              LEFT JOIN contas_bancarias b ON l.conta_id = b.id 
                              WHERE l.user_id = ? 
                              ORDER BY l.id DESC LIMIT 6;", [user_id]);

        return {
            "status": 200,
            "body": {
                "total_receitas": total_receitas,
                "total_despesas": total_despesas,
                "total_dividas": total_dividas,
                "saldo_em_bancos": saldo_contas,
                "limite_cartoes": limite_cartoes,
                "saldo_liquido": saldo_contas - total_dividas,
                "ultimos_lancamentos": ultimos
            }
        };
    }

    # Endpoint de Categorias (GET e POST)
    if (path == "/api/categorias") {
        if (method == "GET") {
            let cats = @query("SELECT * FROM categorias WHERE user_id = ? ORDER BY nome ASC;", [user_id]);
            return { "status": 200, "body": cats };
        }
        if (method == "POST") {
            let nome = body["nome"];
            let tipo = body["tipo"];
            let cor = body.contains("cor") ? body["cor"] : "#3b82f6";
            let icone = body.contains("icone") ? body["icone"] : "tag";
            let id = @exec("INSERT INTO categorias (user_id, nome, tipo, cor, icone) VALUES (?, ?, ?, ?, ?);", [user_id, nome, tipo, cor, icone]);
            return { "status": 201, "body": { "id": id, "nome": nome, "tipo": tipo } };
        }
    }

    # Endpoint de Contas Bancárias (GET e POST)
    if (path == "/api/contas") {
        if (method == "GET") {
            let contas = @query("SELECT * FROM contas_bancarias WHERE user_id = ? ORDER BY id ASC;", [user_id]);
            return { "status": 200, "body": contas };
        }
        if (method == "POST") {
            let banco = body["banco"];
            let tipo = body["tipo"];
            let saldo = body["saldo_inicial"];
            let cor = body.contains("cor") ? body["cor"] : "#10b981";
            let id = @exec("INSERT INTO contas_bancarias (user_id, banco, tipo, saldo_inicial, saldo_atual, cor) VALUES (?, ?, ?, ?, ?, ?);", [user_id, banco, tipo, saldo, saldo, cor]);
            return { "status": 201, "body": { "id": id, "banco": banco, "saldo_atual": saldo } };
        }
    }

    # Endpoint de Cartões de Crédito (GET e POST)
    if (path == "/api/cartoes") {
        if (method == "GET") {
            let cartoes = @query("SELECT * FROM cartoes_credito WHERE user_id = ? ORDER BY id ASC;", [user_id]);
            return { "status": 200, "body": cartoes };
        }
        if (method == "POST") {
            let nome = body["nome"];
            let limite = body["limite"];
            let fecha = body["dia_fechamento"];
            let vence = body["dia_vencimento"];
            let cor = body.contains("cor") ? body["cor"] : "#ec4899";
            let id = @exec("INSERT INTO cartoes_credito (user_id, nome, limite, dia_fechamento, dia_vencimento, cor) VALUES (?, ?, ?, ?, ?, ?);", [user_id, nome, limite, fecha, vence, cor]);
            return { "status": 201, "body": { "id": id, "nome": nome, "limite": limite } };
        }
    }

    # Endpoint de Lançamentos (GET, POST e DELETE)
    if (path == "/api/lancamentos") {
        if (method == "GET") {
            let lancamentos = @query("SELECT l.*, c.nome as categoria_nome, c.cor as categoria_cor, b.banco as conta_nome, cc.nome as cartao_nome 
                                      FROM lancamentos l 
                                      LEFT JOIN categorias c ON l.categoria_id = c.id 
                                      LEFT JOIN contas_bancarias b ON l.conta_id = b.id 
                                      LEFT JOIN cartoes_credito cc ON l.cartao_id = cc.id 
                                      WHERE l.user_id = ? 
                                      ORDER BY l.data_competencia DESC, l.id DESC;", [user_id]);
            return { "status": 200, "body": lancamentos };
        }
        if (method == "POST") {
            let desc = body["descricao"];
            let val = body["valor"];
            let tipo = body["tipo"];
            let dt = body["data_competencia"];
            let status = body.contains("status") ? body["status"] : "CONFIRMADO";
            let cat_id = body.contains("categoria_id") ? body["categoria_id"] : null;
            let conta_id = body.contains("conta_id") ? body["conta_id"] : null;
            let cartao_id = body.contains("cartao_id") ? body["cartao_id"] : null;
            let parc_atual = body.contains("parcela_atual") ? body["parcela_atual"] : 1;
            let tot_parc = body.contains("total_parcelas") ? body["total_parcelas"] : 1;
            let obs = body.contains("observacao") ? body["observacao"] : "";

            let id = @exec("INSERT INTO lancamentos (user_id, descricao, valor, tipo, data_competencia, status, categoria_id, conta_id, cartao_id, parcela_atual, total_parcelas, observacao) 
                           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);", 
                           [user_id, desc, val, tipo, dt, status, cat_id, conta_id, cartao_id, parc_atual, tot_parc, obs]);

            # Se for despesa ou receita confirmada em conta bancária, atualiza o saldo_atual da conta
            if (status == "CONFIRMADO" && conta_id != null) {
                if (tipo == "RECEITA") {
                    @exec("UPDATE contas_bancarias SET saldo_atual = saldo_atual + ? WHERE id = ? AND user_id = ?;", [val, conta_id, user_id]);
                } else if (tipo == "DESPESA") {
                    @exec("UPDATE contas_bancarias SET saldo_atual = saldo_atual - ? WHERE id = ? AND user_id = ?;", [val, conta_id, user_id]);
                }
            }

            return { "status": 201, "body": { "id": id, "sucesso": true } };
        }
    }

    # Endpoint de Dívidas e Recebimentos Futuros
    if (path == "/api/dividas" && method == "GET") {
        let dividas = @query("SELECT l.*, c.nome as categoria_nome, b.banco as conta_nome 
                              FROM lancamentos l 
                              LEFT JOIN categorias c ON l.categoria_id = c.id 
                              LEFT JOIN contas_bancarias b ON l.conta_id = b.id 
                              WHERE l.user_id = ? AND (l.tipo = 'DIVIDA' OR l.status = 'PENDENTE') 
                              ORDER BY l.data_competencia ASC;", [user_id]);
        return { "status": 200, "body": dividas };
    }

    return {
        "status": 404,
        "body": { "erro": "Rota não encontrada", "path": path }
    };
}

# 6. Inicia o Servidor HTTP na porta 8085
print("[Yvira Backend]: Ligando Servidor RESTful Corporativo na porta 8085...");

fn handle_http_request(req) {
    return api_router(req);
}

http.serve(8085, handle_http_request);
