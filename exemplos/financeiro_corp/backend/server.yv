# ==============================================================================
# Servidor Corporativo de Gestão Financeira Multi-Usuário (Yvira Backend)
# Arquitetura: RESTful Microservice, SQLite Database & Multi-tenant Segregation
# Porta Padrão: 8085
# ==============================================================================

import "http";
import "fs";

print("==================================================================");
print("     YVIRA FINANCE SERVER // BACKEND CORPORATIVO MULTI-USUÁRIO     ");
print("==================================================================\n");

# 1. Configuração do Banco de Dados SQLite Local
@db("sqlite://financeiro.db");

# 2. Inicialização DDL (Tabelas Relacionais)
@exec("CREATE TABLE IF NOT EXISTS usuarios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    nome TEXT NOT NULL,
    senha TEXT NOT NULL,
    criado_em TEXT NOT NULL
);");

@exec("CREATE TABLE IF NOT EXISTS categorias (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    nome TEXT NOT NULL,
    tipo TEXT NOT NULL,
    cor TEXT,
    icone TEXT
);");

@exec("CREATE TABLE IF NOT EXISTS contas_bancarias (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    banco TEXT NOT NULL,
    tipo TEXT NOT NULL,
    saldo_inicial REAL DEFAULT 0.0,
    saldo_atual REAL DEFAULT 0.0,
    cor TEXT
);");

@exec("CREATE TABLE IF NOT EXISTS cartoes_credito (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    nome TEXT NOT NULL,
    limite REAL NOT NULL,
    dia_fechamento INTEGER NOT NULL,
    dia_vencimento INTEGER NOT NULL,
    cor TEXT
);");

@exec("CREATE TABLE IF NOT EXISTS lancamentos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    descricao TEXT NOT NULL,
    valor REAL NOT NULL,
    tipo TEXT NOT NULL,
    data_competencia TEXT NOT NULL,
    status TEXT NOT NULL,
    categoria_id INTEGER,
    conta_id INTEGER,
    cartao_id INTEGER,
    parcela_atual INTEGER DEFAULT 1,
    total_parcelas INTEGER DEFAULT 1,
    observacao TEXT
);");

