# Serviço de Busca e Normalização de URLs do Yvira Browser

class SearchService {
    static fn processarInput(entrada) {
        let texto = entrada.trim()

        if (texto.length() == 0) {
            return "https://www.google.com"
        }

        # Se já começa com http:// ou https://
        if (texto.startsWith("http://") || texto.startsWith("https://")) {
            return texto
        }

        # Se parece com um domínio conhecido (ex: youtube.com, github.com, uol.com.br, localhost:3000)
        if (texto.contains(".") && !texto.contains(" ")) {
            return "https://" + texto
        }

        # Caso contrário, trata como termo de pesquisa no Google / DuckDuckGo
        let termoCodificado = texto.replace(" ", "+")
        return "https://www.google.com/search?q=" + termoCodificado
    }
}
