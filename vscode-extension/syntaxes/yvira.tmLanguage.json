{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Yvira",
  "scopeName": "source.yv",
  "patterns": [
    {
      "include": "#directives"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#interpolated-strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#matrix-and-methods"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.yvira",
          "begin": "#-",
          "end": "-#"
        },
        {
          "name": "comment.line.number-sign.yvira",
          "match": "#.*$"
        }
      ]
    },
    "interpolated-strings": {
      "patterns": [
        {
          "name": "string.interpolated.yvira",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yvira",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.yvira",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.yvira" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.yvira" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yvira",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yvira",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.yvira",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.yvira",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.yvira",
          "match": "\\b(null)\\b"
        },
        {
          "name": "variable.language.this.yvira",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.yvira",
          "match": "\\b(if|elif|else|while|for|foreach|in|break|continue|return|import|as|try|catch|finally|throw|match|switch|case|default)\\b"
        },
        {
          "name": "keyword.declaration.yvira",
          "match": "\\b(let|const|fn|function|class|extends|static)\\b"
        },
        {
          "name": "keyword.operator.logical.yvira",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.yvira",
          "match": "\\b(print|println|input|toNumber|to_number|toInt|to_int|floor|round|toString|to_string|range|list|len|length|count|clock|time|seed|random_seed|random|zeros|ones|eye|identity|randMat|rand_mat|solve|menu|menu_interativo|confirmar|confirm|caixa|box|barra_progresso|progress_bar|tabela|table|limpar_tela|clear|dormir|sleep|criar_janela|janela|window)\\b"
        }
      ]
    },
    "matrix-and-methods": {
      "patterns": [
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "support.function.method.yvira"
            }
          }
        },
        {
          "match": "\\.(rows|cols|linhas|colunas|length|len|count|T|det|trace|sum|mean|max|min|keys|values)\\b",
          "captures": {
            "1": {
              "name": "variable.other.property.yvira"
            }
          }
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "\\b(fn|function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.yvira"
            },
            "2": {
              "name": "entity.name.function.yvira"
            }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.yvira"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.yvira",
          "match": "(=|\\+=|-=|\\*=|/=|%=|\\*\\*=)"
        },
        {
          "name": "keyword.operator.arrow.yvira",
          "match": "(=>|->)"
        },
        {
          "name": "keyword.operator.comparison.yvira",
          "match": "(==|!=|<>|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.yvira",
          "match": "(\\+\\+|--|\\+|\\-|\\*\\*|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.symbol.yvira",
          "match": "(&&|\\|\\||!|\\?|:)"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.yvira",
          "match": "@(time|stop|db|exec|query|transaction|spawn|worker|realtime|pdf|sleep|die)(\\.[a-zA-Z_][a-zA-Z0-9_]*)?"
        }
      ]
    }
  }
}
