{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Yvira",
  "scopeName": "source.yv",
  "patterns": [
    {
      "include": "#directives"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#function-declaration"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.yvira",
          "begin": "#-",
          "end": "-#"
        },
        {
          "name": "comment.line.number-sign.yvira",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yvira",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yvira",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.yvira",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.yvira",
          "match": "\\b(if|else|while|for|foreach|in|break|continue|return|import|as|try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.declaration.yvira",
          "match": "\\b(let|const|fn|class)\\b"
        },
        {
          "name": "constant.language.boolean.yvira",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "keyword.operator.logical.yvira",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.yvira",
          "match": "\\b(print|println|input|toNumber|to_number|toString|to_string|range|list|len|length|tamanho|size|count|clock|time|random|zeros|ones|eye|identity|randMat|rand_mat|solve)\\b"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.yvira"
            },
            "2": {
              "name": "entity.name.function.yvira"
            }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.yvira"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.yvira",
          "match": "(=|\\+=|-=|\\*=|/=|\\*\\*=)"
        },
        {
          "name": "keyword.operator.comparison.yvira",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.yvira",
          "match": "(\\+|\\-|\\*\\*|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.symbol.yvira",
          "match": "(&&|\\|\\||!)"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.yvira",
          "match": "@(time|stop|db|exec|query)(\\.[a-zA-Z_][a-zA-Z0-9_]*)?"
        }
      ]
    }
  }
}